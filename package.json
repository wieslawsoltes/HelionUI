{
  "name": "@helion/ui",
  "version": "0.15.0-experimental",
  "private": true,
  "type": "module",
  "description": "Experimental compute UI with retained OpenType shaping, bidi paragraph layout, templates, editors and visual designer",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./protocol": "./src/core/protocol.js",
    "./text": "./src/text/index.js",
    "./layout": "./src/layout/index.js",
    "./styling": "./src/styling/index.js",
    "./drawing": "./src/drawing/index.js",
    "./composition": "./src/composition/index.js",
    "./editor": "./src/editor/index.js",
    "./docking": "./src/docking/index.js",
    "./models": "./src/models/index.js",
    "./data": "./src/data/index.js",
    "./controls": "./src/controls/index.js",
    "./designer": "./src/designer/index.js",
    "./templates": "./src/templates/index.js",
    "./typography": "./src/typography/index.js"
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "check:build": "node tools/check-build.mjs",
    "check:native": "node tools/check-native.mjs",
    "check:browser": "node tools/browser-test.mjs",
    "build:typography": "node tools/package-typography.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

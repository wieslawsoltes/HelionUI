fn dockCommand(host:u32,op:u32,pane:u32,arg:f32){if((VIEW_FEATURES&2u)==0u){return;}if(host>=frame.counts.x||nodes[host].info.x!=24u||pane>=frame.counts.x||nodes[pane].info.x!=25u){return;}let p=nodes[pane].aux.x;if(heap[p]!=host){return;}let d=nodes[host].aux.x;let tree=heap[d+2u];let group=heap[p+1u];switch op{

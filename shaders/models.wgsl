fn modelField(d:u32,field:u32)->u32{return heap[d+2u]+field*8u;}
fn modelRead(d:u32,field:u32,row:u32)->f32{let f=modelField(d,field);let v=heap[heap[f+1u]+row];switch heap[f]{case 1u:{return bitcast<f32>(v);}case 3u:{return f32(bitcast<i32>(v));}default:{return f32(v);}}}
fn modelStore(d:u32,field:u32,row:u32,value:f32){if((bitcast<u32>(value)&0x7f800000u)==0x7f800000u){heap[heap[d+10u]+row]++;return;}let f=modelField(d,field);var v=0u;switch heap[f]{case 1u:{v=bitcast<u32>(value);}case 2u:{v=u32(clamp(value,0.0,16777216.0));}case 3u:{v=bitcast<u32>(i32(clamp(value,-16777216.0,16777216.0)));}case 4u:{v=select(0u,1u,value!=0.0);}default:{}}heap[heap[f+1u]+row]=v;heap[heap[d+8u]+row]=1u;}
fn modelEval(d:u32,row:u32,program:u32,count:u32,arg:f32)->f32{var stack:array<f32,64>;var n=0u;for(var k=0u;k<count;k++){let at=program+k*2u;let op=heap[at];if(op==0u){stack[n]=hf(at+1u);n++;continue;}if(op==1u){stack[n]=modelRead(d,heap[at+1u],row);n++;continue;}if(op==2u){stack[n]=arg;n++;continue;}
 var a=stack[n-1u];var v=a;
 if(op==16u||op==38u){let b=stack[n-2u];let c=stack[n-3u];n-=2u;v=select(clamp(c,min(a,b),max(a,b)),select(a,b,c!=0.0),op==38u);}
 else if((op>=17u&&op<=24u)||op==35u){switch op{case 17u:{v=-a;}case 18u:{v=abs(a);}case 19u:{v=sin(a);}case 20u:{v=cos(a);}case 21u:{v=sqrt(max(0.0,a));}case 22u:{v=floor(a);}case 23u:{v=ceil(a);}case 24u:{v=round(a);}case 35u:{v=select(0.0,1.0,a==0.0);}default:{}}}
 else{let b=stack[n-2u];n--;switch op{case 10u:{v=b+a;}case 11u:{v=b-a;}case 12u:{v=b*a;}case 13u:{v=select(0.0,b/select(1.0,a,a!=0.0),a!=0.0);}case 14u:{v=min(b,a);}case 15u:{v=max(b,a);}case 30u:{v=select(0.0,1.0,b<a);}case 31u:{v=select(0.0,1.0,b<=a);}case 32u:{v=select(0.0,1.0,b>a);}case 33u:{v=select(0.0,1.0,b>=a);}case 34u:{v=select(0.0,1.0,b==a);}case 36u:{v=select(0.0,1.0,b!=0.0&&a!=0.0);}case 37u:{v=select(0.0,1.0,b!=0.0||a!=0.0);}default:{}}}
 stack[n-1u]=v;
 }return stack[0];}
fn modelRefreshRow(d:u32,row:u32){if(heap[heap[d+8u]+row]==0u){return;}for(var k=0u;k<heap[d+4u];k++){let field=heap[heap[d+3u]+k];let f=modelField(d,field);modelStore(d,field,row,modelEval(d,row,heap[f+3u],heap[f+4u],0.0));}heap[heap[d+8u]+row]=0u;heap[heap[d+9u]+row]++;}
fn modelCommand(index:u32,row:u32,op:u32,arg:f32,field:u32){if((VIEW_FEATURES&4u)==0u){return;}if(index>=state[63u]){return;}let d=heap[state[62u]+index];if(row>=heap[d]){return;}if(op==0u){if(field>=heap[d+1u]||heap[modelField(d,field)+2u]!=0u){return;}modelStore(d,field,row,arg);return;}if(op>heap[d+6u]){return;}modelRefreshRow(d,row);let c=heap[d+5u]+(op-1u)*4u;if(modelEval(d,row,heap[c+2u],heap[c+3u],arg)==0.0){return;}var values:array<f32,32>;for(var k=0u;k<heap[c+1u];k++){let a=heap[c]+k*4u;values[k]=modelEval(d,row,heap[a+1u],heap[a+2u],arg);if((bitcast<u32>(values[k])&0x7f800000u)==0x7f800000u){heap[heap[d+10u]+row]++;return;}}for(var k=0u;k<heap[c+1u];k++){modelStore(d,heap[heap[c]+k*4u],row,values[k]);}}
// Bound UI fan-in has one owner: two fields of one row must not race its dirty word.
@compute @workgroup_size(1)
fn pullModels(){for(var i=0u;i<frame.counts.x;i++){let n=nodes[i];if(n.bind.y!=12u){continue;}let b=n.bind.x;if(heap[b+3u]==0u){continue;}let v=state[cs(i)];if(v!=heap[b+5u]){modelStore(heap[b],heap[b+1u],heap[b+2u],bitcast<f32>(v));heap[b+5u]=v;}}}
@compute @workgroup_size(64)
fn evaluateModels(@builtin(global_invocation_id) tid:vec3<u32>){if(tid.y>=state[63u]){return;}let d=heap[state[62u]+tid.y];if(tid.x<heap[d]){modelRefreshRow(d,tid.x);}}
@compute @workgroup_size(1)
fn pushModels(){for(var i=0u;i<frame.counts.x;i++){let n=nodes[i];if(n.bind.y!=12u){continue;}let b=n.bind.x;let value=modelRead(heap[b],heap[b+1u],heap[b+2u]);let property=heap[b+4u];var prior=sf(cs(i));if(property==1u){prior=n.size.x;}if(property==2u){prior=n.size.y;}if(property==3u){prior=sf(cs(i)+3u);}if(property>=4u&&property<=8u){prior=sf(cs(i)+property+4u);}if(property==9u){prior=select(0.0,1.0,(n.text.y&32u)==0u);}if(property==10u){prior=sf(cs(i)+1u);}if(property==11u){prior=n.limits.z;}if(value!=prior){applyProperty(i,property,value);}heap[b+5u]=bitcast<u32>(value);}}
